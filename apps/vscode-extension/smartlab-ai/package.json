{
  "name": "smartlab-ai",
  "displayName": "SmartLab AI",
  "description": "AI powered smart code review and lab assistant",
  "version": "0.0.1",
  "publisher": "smartlab",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "activationEvents": ["*"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "smartlab-ai.reviewCode",
        "title": "SmartLab: Review Code"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "smartlab",
          "title": "SmartLab AI",
          "icon": "resources/smartlab.svg"
        }
      ]
    },
    "views": {
      "smartlab": [
        {
          "type": "webview",
          "id": "smartlab.agent",
          "name": "SmartLab Agent"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}